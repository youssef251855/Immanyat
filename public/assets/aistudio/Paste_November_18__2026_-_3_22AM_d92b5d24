    CASE_MATCH=$(printf '%s\n' "$AVAILABLE_ALIASES" | grep -Fix "$ALIAS_TRIMMED" | head -n 1 || true)
    if [ -n "$EXACT_MATCH" ]; then
      RESOLVED_ALIAS="$EXACT_MATCH"
    elif [ -n "$CASE_MATCH" ]; then
      RESOLVED_ALIAS="$CASE_MATCH"
    else
