# BACKEND_BASE_URL: HTTPS base URL of your deployed Cloudflare Worker backend for Quran recitation & correction (e.g. https://emaniat-api.your-subdomain.workers.dev)
# GEMINI_API_KEY lives strictly on the Cloudflare Worker and must NEVER be placed in the APK.
BACKEND_BASE_URL=UNCONFIGURED_BACKEND_BASE_URL

# BACKEND_CLIENT_TOKEN: Optional shared header token matching Cloudflare secret APP_CLIENT_TOKEN (not a server API key)
BACKEND_CLIENT_TOKEN=UNCONFIGURED_BACKEND_CLIENT_TOKEN

# STARTIO_APP_ID: Public publisher App ID for Start.io SDK if enabled
STARTIO_APP_ID=200676644
