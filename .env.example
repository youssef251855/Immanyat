# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# STARTIO_APP_ID: Required for Start.io banner and interstitial ads initialization.
STARTIO_APP_ID=200676644

# PAYPAL_CLIENT_ID: Your PayPal Client ID. Create one in the PayPal Developer Dashboard.
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_PLACEHOLDER

# PAYPAL_CLIENT_SECRET: Your PayPal Client Secret. Create one in the PayPal Developer Dashboard.
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET_PLACEHOLDER
